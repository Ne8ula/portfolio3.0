{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "agent:handoff": "node scripts/agent-handoff.mjs show",
    "agent:handoff:install-kimi": "node scripts/agent-handoff.mjs install-kimi-hook",
    "agent:handoff:uninstall-kimi": "node scripts/agent-handoff.mjs uninstall-kimi-hook",
    "phase:init": "node --import tsx scripts/phase-runner/phase-runner.ts init",
    "phase:status": "node --import tsx scripts/phase-runner/phase-runner.ts status",
    "phase:dry-run": "node --import tsx scripts/phase-runner/phase-runner.ts dry-run",
    "phase:doctor": "node --import tsx scripts/phase-runner/phase-runner.ts doctor",
    "phase:run": "node --import tsx scripts/phase-runner/phase-runner.ts run",
    "phase:pause": "node --import tsx scripts/phase-runner/phase-runner.ts pause",
    "phase:resume": "node --import tsx scripts/phase-runner/phase-runner.ts resume",
    "phase:retry": "node --import tsx scripts/phase-runner/phase-runner.ts retry",
    "phase:accept": "node --import tsx scripts/phase-runner/phase-runner.ts accept",
    "phase:recover": "node --import tsx scripts/phase-runner/phase-runner.ts recover",
    "phase:continue": "node --import tsx scripts/phase-runner/phase-runner.ts continue",
    "phase:retest": "node --import tsx scripts/phase-runner/phase-runner.ts retest",
    "typecheck:contracts": "tsc -p tsconfig.contracts.json",
    "validate:contracts": "node --import tsx scripts/validate-contracts.ts",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@pmndrs/vanilla": "^1.25.0",
    "@vercel/analytics": "1.3.1",
    "client-only": "^0.0.1",
    "next": "16.0.10",
    "postprocessing": "^6.39.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.184.0",
    "three-mesh-bvh": "^0.9.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.0",
    "eslint": "^10.8.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
